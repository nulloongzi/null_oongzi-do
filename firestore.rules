rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 관리자 체크 함수: /admins/{uid} 문서 존재 여부
    function isAdmin() {
      return request.auth != null
             && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 이 팀을 관리할 수 있는 uid 목록.
    //
    // admins 가 정본이지만 그 필드가 생기기 전 문서에는 없다. 그때(필드가 없거나
    // 배열이 아닐 때)만 registered_by 한 사람을 관리자로 본다 — 마이그레이션을
    // 안 돌려도 기존 소유자가 권한을 잃지 않는다. 빈 배열 `admins: []` 는
    // "관리자 없음"이다. functions/lib/pure.js 의 clubAdminUids 와 같은 규칙이다.
    // 둘이 어긋나면 화면엔 버튼이 보이는데 저장은 거부된다.
    function clubAdmins(d) {
      return ('admins' in d && d.admins is list)
             ? d.admins
             : (d.registered_by != null ? [d.registered_by] : []);
    }

    function isClubManager(d) {
      return request.auth != null && request.auth.uid in clubAdmins(d);
    }

    // admins 는 Functions(admin SDK)만 바꾼다. 클라이언트가 직접 고칠 수 있으면
    // 자기 uid 를 끼워넣어 아무 팀이나 가져갈 수 있다 — 승인 절차가 무의미해진다.
    // request.resource.data 는 '쓰기 후 문서 전체'라, 건드리지 않은 update 는
    // 기존 값이 그대로 실려 와 통과한다.
    function adminsUnchanged() {
      return (('admins' in request.resource.data) ? request.resource.data.admins : [])
          == (('admins' in resource.data) ? resource.data.admins : []);
    }

    // 릴스 필드 — 팀·픽업 공통.
    //
    // 개수 상한(10)은 js/dom-utils.js 의 MAX_REELS · 앱 Sanitize.maxReels 와 같다.
    // 어긋나면 폼은 통과시켰는데 저장이 거부된다.
    // 룰은 리스트 원소를 돌며 검사할 수 없어서 원소 형식은 클라이언트가 걸러
    // 쓰고, 화면은 그릴 때 permalink 화이트리스트로 한 번 더 거른다.
    function reelFieldsValid(d) {
      return (!('insta_reel' in d) || (d.insta_reel is string && d.insta_reel.size() <= 200))
          && (!('insta_reels' in d) || (d.insta_reels is list && d.insta_reels.size() <= 10))
          && (!('reels_hidden' in d) || d.reels_hidden is bool);
    }

    // 운영자가 내린 릴스 숨김(reels_hidden)과 커버 캐시(insta_reel_covers)는
    // 팀 관리자·픽업 소유자가 건드릴 수 없다.
    //   · reels_hidden — 본인이 풀 수 있으면 숨김이 아니다.
    //   · insta_reel_covers — Functions(admin SDK)만 채운다. 클라이언트가 쓸 수
    //     있으면 인스타를 거치지 않은 아무 이미지 URL이나 커버로 앱 화면에
    //     그대로 뜬다. 화면의 링크 화이트리스트가 이미지에는 적용되지 않는다.
    // get() 기본값으로 비교해서, 필드를 건드리지 않는 update 는 그대로 통과한다.
    function moderationUnchanged() {
      return request.resource.data.get('reels_hidden', false) == resource.data.get('reels_hidden', false)
          && request.resource.data.get('insta_reel_covers', null) == resource.data.get('insta_reel_covers', null);
    }

    // 새로 만드는 문서가 숨김 해제 상태나 커버를 들고 들어오지 못하게 한다.
    function moderationFreshOnCreate() {
      return request.resource.data.get('reels_hidden', false) == false
          && !('insta_reel_covers' in request.resource.data);
    }

    // 팀 문서 필드 타입·길이 검증 (doc 비대화·잘못된 타입 주입 방지).
    // 존재하는 필드에 대해서만 검사 — 부분 update(merge)도 통과.
    function clubFieldsValid() {
      let d = request.resource.data;
      return (!('name' in d) || (d.name is string && d.name.size() > 0 && d.name.size() <= 80))
          && (!('target' in d) || (d.target is string && d.target.size() <= 80))
          && (!('address' in d) || (d.address is string && d.address.size() <= 250))
          && (!('price' in d) || (d.price is string && d.price.size() <= 120))
          && (!('schedule' in d) || (d.schedule is string && d.schedule.size() <= 600))
          && (!('urgent_msg' in d) || (d.urgent_msg is string && d.urgent_msg.size() <= 250))
          && (!('is_urgent' in d) || d.is_urgent is bool)
          // 급구 기한(고른 운동이 끝나는 시각)·올린 시각·운영자 차단 기한, 회원 모집.
          // 새 급구 문구는 postUrgent 가 60자로 자른다 — 위 250 은 예전 급구용.
          && (!('urgent_until' in d) || d.urgent_until is timestamp)
          && (!('urgent_at' in d) || d.urgent_at is timestamp)
          && (!('urgent_blocked_until' in d) || d.urgent_blocked_until is timestamp)
          && (!('is_recruiting' in d) || d.is_recruiting is bool)
          && (!('recruit_msg' in d) || (d.recruit_msg is string && d.recruit_msg.size() <= 60))
          && (!('recruit_at' in d) || d.recruit_at is timestamp)
          // 🥄 맛보기 환영(체험·게스트도 받음) — 식구 모집이 켜져 있을 때만 화면에 뜬다.
          && (!('recruit_drop_in' in d) || d.recruit_drop_in is bool)
          && (!('contact' in d) || (d.contact is map
                && (!('insta' in d.contact) || (d.contact.insta is string && d.contact.insta.size() <= 60))
                && (!('link' in d.contact) || (d.contact.link is string && d.contact.link.size() <= 500))))
          && (!('coordinates' in d) || (d.coordinates is map
                && d.coordinates.lat is number && d.coordinates.lng is number))
          // 데이터 신뢰도(guidelines.html 2-3): 최종 확인일 + 상태.
          // 소유자 수정은 곧 '지금도 맞다'는 확인이므로 폼 저장 때마다 갱신된다.
          && (!('last_verified_at' in d) || d.last_verified_at is timestamp)
          && (!('data_status' in d) || d.data_status in ['active', 'needs_check', 'dormant'])
          // 관리자 정원 3명. 넘는 배열이 들어오면 그 자체가 잘못된 쓰기다.
          && (!('admins' in d) || (d.admins is list && d.admins.size() <= 3))
          && (!('location_precision' in d) || d.location_precision in ['exact', 'area'])
          && reelFieldsValid(d)
          && areaCoordsCoarse();
    }

    // 급구(is_urgent) — 지도에 빨간 마커·티커로 크게 뜨는 표시라 **켜기는 서버만** 한다.
    // postUrgent(callable, admin SDK)가 인증·관리자·차단·기한(운동 한 번, 7일 안)·문구
    // (60자, 링크·전화번호 금지)를 보고 urgent_log 에 남긴 뒤 쓴다. 팀 관리자 경로에서는:
    //   · 급구 네 필드(is_urgent · urgent_msg · urgent_until · urgent_at)를 그대로 두면 통과 —
    //     급구가 떠 있는 동안에도 팀 정보는 고칠 수 있게. 기한을 늘리거나 문구를 바꾸려면
    //     callable 을 다시 부른다(고치기도 같은 길).
    //   · 끄기(after.is_urgent != true)는 언제나 된다. 기한·시각은 지우거나 그대로 둘 수만
    //     있다 — 꺼둔 채 새 기한을 심어두는 길을 막는다.
    // 운영자 경로는 그대로 신뢰. 화면도 인증된 팀 관리자에게만 '급구 올리기'를 보인다.
    function urgentChangeOk() {
      let after = request.resource.data;
      let before = resource.data;
      return (after.get('is_urgent', false) == before.get('is_urgent', false)
              && after.get('urgent_msg', '') == before.get('urgent_msg', '')
              && after.get('urgent_until', null) == before.get('urgent_until', null)
              && after.get('urgent_at', null) == before.get('urgent_at', null))
          || (after.get('is_urgent', false) != true
              && (!('urgent_until' in after) || after.urgent_until == before.get('urgent_until', null))
              && (!('urgent_at' in after) || after.urgent_at == before.get('urgent_at', null)));
    }

    // 운영자가 콘솔에서 거는 급구 차단 기한. 팀 관리자가 풀 수 있으면 차단이 아니다.
    function urgentBlockUnchanged() {
      return request.resource.data.get('urgent_blocked_until', null)
          == resource.data.get('urgent_blocked_until', null);
    }

    // 회원 모집(is_recruiting) — 인증 여부와 상관없이 팀 관리자가 직접 켜고 끈다.
    // 켤 때·문구를 바꿀 때는 recruit_at 이 서버 시각(request.time)이어야 한다. 정리
    // (sweepClubFlags)가 max(recruit_at, last_verified_at) 로 60일을 세므로, 켜진 채
    // 그 밖의 수정에서도 recruit_at 은 그대로 두거나 지금 시각으로만 바꿀 수 있다 —
    // 앞날짜를 심어 영영 안 꺼지는 모집을 막는다. 끄기는 언제나 된다.
    // 맛보기(recruit_drop_in)만 바꾸는 건 recruit_at 을 건드리지 않아도 된다(타입은 clubFieldsValid).
    function recruitChangeOk() {
      let after = request.resource.data;
      let before = resource.data;
      return after.get('is_recruiting', false) != true
          || after.get('recruit_at', null) == request.time
          || (before.get('is_recruiting', false) == true
              && after.get('recruit_msg', '') == before.get('recruit_msg', '')
              && after.get('recruit_at', null) == before.get('recruit_at', null));
    }

    // 위치를 '대략만' 공개하기로 한 팀은 **정확한 좌표를 저장하지 못하게** 한다.
    //
    // clubs 는 allow read: if true 다. 화면에서만 흐리게 그리면 Firestore 를 직접
    // 읽어 정확한 값을 그대로 꺼낼 수 있으므로, 흐리는 건 저장 단계여야 한다.
    // 여기서 막지 않으면 '대략만'은 사실상 아무것도 안 하는 표시가 된다.
    //
    // 0.005° 격자(≈ 위도 550m). 식이 functions/lib/pure.js 의 roundToAreaGrid 와
    // **같아야** 한다 — 부동소수 결과가 어긋나면 정상 저장이 거부된다.
    function areaCoordsCoarse() {
      let d = request.resource.data;
      return !('location_precision' in d)
          || d.location_precision != 'area'
          || !('coordinates' in d)
          || d.coordinates == null
          || (gridAligned(d.coordinates.lat) && gridAligned(d.coordinates.lng));
    }

    // 값을 200배 했을 때 정수인가. 나눗셈을 쓰지 않는 이유는 math.round() 가
    // **정수**를 돌려줘서 `/ 200` 이 정수 나눗셈이 되기 때문이다(37 이 나온다).
    // 빼기로 비교하면 double 로 승격되고, 부동소수 잡음도 함께 흡수한다 —
    // 클라이언트의 Math.round(v*200)/200 결과가 *200 했을 때 정확히 정수가
    // 아닐 수 있어서, 엄격 일치로 두면 정상 저장이 거부된다.
    function gridAligned(v) {
      return math.abs(v * 200 - math.round(v * 200)) < 0.000001;
    }

    // 픽업 스팟 필드 타입·길이 검증 (존재 필드만 검사 → 부분 update도 통과)
    function pickupFieldsValid() {
      let d = request.resource.data;
      return (!('title' in d) || (d.title is string && d.title.size() > 0 && d.title.size() <= 80))
          && (!('sport' in d) || (d.sport is string && d.sport.size() <= 20))
          && (!('level' in d) || (d.level is string && d.level.size() <= 20))
          && (!('beginner_friendly' in d) || d.beginner_friendly is bool)
          && (!('english_ok' in d) || d.english_ok is bool)
          && (!('venue_name' in d) || (d.venue_name is string && d.venue_name.size() <= 120))
          && (!('address' in d) || (d.address is string && d.address.size() <= 250))
          && (!('schedule' in d) || (d.schedule is string && d.schedule.size() <= 600))
          && (!('schedule_raw' in d) || (d.schedule_raw is list && d.schedule_raw.size() <= 50))
          && (!('schedule_text' in d) || (d.schedule_text is string && d.schedule_text.size() <= 200))
          && (!('fee_info' in d) || (d.fee_info is string && d.fee_info.size() <= 120))
          && (!('contact_link' in d) || (d.contact_link is string && d.contact_link.size() <= 500))
          && (!('this_week' in d) || (d.this_week is string && d.this_week.size() <= 200))
          && (!('notes' in d) || (d.notes is string && d.notes.size() <= 600))
          && (!('insta' in d) || (d.insta is string && d.insta.size() <= 80))
          && (!('region' in d) || (d.region is string && d.region.size() <= 20))
          && reelFieldsValid(d)
          // 'curated' = 공개 인스타 정보로 시딩된 항목(본인 등록 아님).
          // UI가 출처를 밝히고 삭제 요청 통로를 띄우는 근거 — 옵트아웃 모델의 최소 조건.
          && (!('source' in d) || (d.source is string && d.source.size() <= 20))
          && (!('expire_at' in d) || d.expire_at == null || d.expire_at is timestamp)
          // 좌표는 선택 — 장소가 유동적인 크루(지도에 안 뜨고 목록에만)를 허용한다.
          // null 명시도 통과시켜야 클라이언트가 필드를 지울 수 있다.
          && (!('coordinates' in d) || d.coordinates == null || (d.coordinates is map
                && d.coordinates.lat is number && d.coordinates.lng is number));
    }

    // clubs: 모두 읽기, 소유자/관리자만 수정
    match /clubs/{clubId} {
      allow read: if true;

      // 새 팀 등록: 인증된 사용자가 자신을 registered_by 로 기록, is_verified=false 강제.
      // 등록자가 곧 1번 관리자다. admins 를 함께 쓰더라도
      // 본인 혼자만 넣을 수 있다 — 만들면서 남을 끼워넣지 못하게.
      // 급구는 서버(postUrgent)만 켜니 새 팀은 꺼진 채로, 기한·차단 필드 없이 들어온다.
      // 회원 모집도 꺼진 채로 시작한다(켜기는 recruit_at 규칙을 타는 update 로). 맛보기도 꺼진 채.
      allow create: if request.auth != null
                    && request.resource.data.registered_by == request.auth.uid
                    && request.resource.data.is_verified == false
                    && request.resource.data.get('is_urgent', false) == false
                    && request.resource.data.get('is_recruiting', false) == false
                    && request.resource.data.get('recruit_drop_in', false) == false
                    && !('urgent_until' in request.resource.data)
                    && !('urgent_at' in request.resource.data)
                    && !('urgent_blocked_until' in request.resource.data)
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && (!('admins' in request.resource.data)
                        || (request.resource.data.admins is list
                            && request.resource.data.admins.size() == 1
                            && request.auth.uid in request.resource.data.admins))
                    && moderationFreshOnCreate()
                    && clubFieldsValid();

      // 업데이트: 운영자는 모든 필드(신뢰), 팀 관리자는 is_verified/registered_by/
      // admins 를 보존한 채 내용만. 인증 배지와 관리자 명단은 심사를 거친 값이라
      // 본인이 스스로 올릴 수 없어야 한다.
      // 정원 검사는 isAdmin() 바깥에 둔다. `isAdmin() || (...)` 구조라 운영자
      // 경로는 clubFieldsValid() 를 타지 않아, 안에 두면 콘솔에서 4명짜리
      // 배열이 그대로 들어간다. (Functions 는 admin SDK 라 룰을 통째로
      // 우회하므로 서버의 정상 경로는 여기 걸리지 않는다.)
      // 정원과 마찬가지로 위치 흐리기도 isAdmin() 바깥이다. 둘 다 '팀에게 한
      // 약속'이라, 운영자 콘솔에서 조용히 깨질 수 있으면 약속이 아니다.
      allow update: if (!('admins' in request.resource.data)
                        || (request.resource.data.admins is list
                            && request.resource.data.admins.size() <= 3))
                    && areaCoordsCoarse()
                    && (isAdmin()
                    || (request.auth != null
                        && isClubManager(resource.data)
                        && request.resource.data.is_verified == resource.data.is_verified
                        && request.resource.data.registered_by == resource.data.registered_by
                        && adminsUnchanged()
                        && moderationUnchanged()
                        && urgentChangeOk()
                        && urgentBlockUnchanged()
                        && recruitChangeOk()
                        && clubFieldsValid()));

      // 삭제: 운영자 또는 팀 관리자
      allow delete: if isAdmin()
                    || (request.auth != null && isClubManager(resource.data));

      // 급구 기록(post · expire · unverified · no_admin · migrate). Functions(admin SDK)만
      // 쓴다. 누가 언제 무슨 문구로 올렸나라 운영자만 읽는다.
      match /urgent_log/{logId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // pickup_games: 픽업 스팟(발견형). 모두 읽기, 누구나 등록(무로그인=익명 인증 포함).
    // 결제·정원·참가자(RSVP) 없음 — 들어가는 문은 contact_link(단톡/Meetup).
    match /pickup_games/{spotId} {
      allow read: if true;

      // 등록: 로그인 또는 익명 인증 사용자가 owner_uid=본인으로 생성
      allow create: if request.auth != null
                    && request.resource.data.owner_uid == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && moderationFreshOnCreate()
                    && pickupFieldsValid();

      // 수정: 소유자(owner_uid·운영자 숨김 보존) 또는 관리자
      allow update: if (request.auth != null
                        && resource.data.owner_uid == request.auth.uid
                        && request.resource.data.owner_uid == resource.data.owner_uid
                        && moderationUnchanged()
                        && pickupFieldsValid())
                    || isAdmin();

      // 삭제: 소유자 또는 관리자(스팸 모더레이션)
      allow delete: if (request.auth != null && resource.data.owner_uid == request.auth.uid)
                    || isAdmin();
    }

    // verification_requests: 신청자 본인/관리자만 읽기, Cloud Functions만 update
    match /verification_requests/{requestId} {
      allow read: if isAdmin()
                  || (request.auth != null
                      && resource.data.requested_by == request.auth.uid);

      allow create: if request.auth != null
                    && request.resource.data.requested_by == request.auth.uid
                    && request.resource.data.status == "pending";

      // update/delete: Cloud Functions(admin SDK)만 가능
      allow update, delete: if false;
    }

    // reports: 잘못된 정보 신고 (guidelines.html 3-1). 인증 배지 심사와 같은 파이프를
    // 타서 Cloud Function이 운영자 카톡으로 알린다.
    //
    // 무로그인 허용이 핵심이다 — 제3자는 신고하려고 로그인까지 하지 않는다.
    // 그래서 익명 인증(uid만 확보)으로 쓸 수 있게 열되, 스팸 문은 두 겹으로 좁힌다:
    //   1) hasOnly() 필드 화이트리스트 — 임의 필드로 문서를 불릴 수 없다
    //   2) 길이 제한 + 사유 enum — 본문이 저장소가 되지 않는다
    // 신고 내용은 제3자가 쓴 미검증 주장이라 공개 읽기는 막는다(명예훼손·역추적 방지).
    // 신고자가 자기 신고를 닫을 수 없도록 update/delete는 Functions(admin SDK) 전용.
    function reportFieldsValid() {
      let d = request.resource.data;
      return d.keys().hasOnly([
               'kind', 'target_id', 'target_name', 'reason', 'detail',
               'reporter_uid', 'status', 'created_at'
             ])
          && d.kind in ['club', 'pickup']
          && d.target_id is string && d.target_id.size() > 0 && d.target_id.size() <= 200
          && (!('target_name' in d) || (d.target_name is string && d.target_name.size() <= 120))
          && d.reason in ['wrong_info', 'closed', 'duplicate', 'inappropriate', 'other']
          && (!('detail' in d) || (d.detail is string && d.detail.size() <= 500))
          && d.created_at is timestamp;
    }

    match /reports/{reportId} {
      // 조회는 관리자만 — 목록이 열리면 '누가 어느 팀을 신고했나'가 공개된다.
      allow read: if isAdmin();

      allow create: if request.auth != null
                    && request.resource.data.reporter_uid == request.auth.uid
                    && request.resource.data.status == 'open'
                    && reportFieldsValid();

      // 처리(status 변경)·삭제는 Cloud Functions(admin SDK)만.
      allow update, delete: if false;
    }

    // ── 예약 닉네임 ──────────────────────────────────────────────
    // '누룽지'·'Nulloongzi'·'null_oongzi' 같은 서비스 이름은 공식 계정만 쓴다 — 아무나 쓰면
    // 운영자인 척할 수 있다. 공백·기호·대소문자를 걷어내고 비교해서 '누 룽 지', 'Null_Oongzi',
    // 'NULL-oongzi' 도 걸린다. js/profile.js isReservedNickname · 앱 reservedNickname() 과
    // 같은 목록이어야 한다(tests/reserved-nickname.test.js 가 대조한다).
    function isReservedNickname(s) {
      return s.lower().replace('[^a-z0-9가-힣]', '')
               .matches('.*(누룽지|nulloongzi|nuloongzi|nullongzi|nurungji|nurungzi|nuroongzi).*');
    }
    // 예약 닉네임을 쓸 수 있는 계정: 운영자(admins) 또는 공식 계정 목록(official_accounts).
    // 부계정을 admins 에 넣으면 팀 삭제 같은 운영 권한까지 생기므로 목록을 나눴다.
    function canUseReservedNickname() {
      return isAdmin()
             || exists(/databases/$(database)/documents/official_accounts/$(request.auth.uid));
    }
    // 이 필드를 새로 쓰거나 바꿀 때만 본다 — 이미 쓰던 이름은 그대로 두고, 다른 필드를 고치는
    // 쓰기(색상 등)도 막지 않는다.
    function nicknameFieldOk(field) {
      return !(field in request.resource.data)
             || (resource != null && field in resource.data
                 && request.resource.data[field] == resource.data[field])
             || (request.resource.data[field] is string
                 && (!isReservedNickname(request.resource.data[field]) || canUseReservedNickname()));
    }

    // users: 공개 프로필 (닉네임/색상). email·bookmarks·customTeams는
    // private 서브컬렉션으로 분리하여 PIPA 위험(이메일 공개 덤프) 차단.
    match /users/{userId} {
      allow read: if true;
      // 공개 필드만 허용. lazy migration 시 비공개 필드 삭제(FieldValue.delete())로
      // 결과 키 집합이 화이트리스트에 맞춰지면 통과.
      allow write: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasOnly([
                         'nickname', 'suffix', 'full_nickname', 'color', 'created_at'
                       ])
                    && nicknameFieldOk('full_nickname')
                    && nicknameFieldOk('nickname');
    }

    // official_accounts: 예약 닉네임을 쓸 수 있는 공식 계정(운영자 부계정 등).
    // admins 와 같은 모양 — 본인 uid get 만, 쓰기는 콘솔/admin SDK 에서만.
    match /official_accounts/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;
      allow write: if false;
    }

    // users 비공개 프로필: 본인만 읽기/쓰기
    match /users/{userId}/private/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // admins: 관리자 목록. list 금지(관리자 UID 덤프 차단), 본인 uid get만 허용.
    // 쓰기는 콘솔/admin SDK에서만.
    match /admins/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;
      allow write: if false;
    }

    // system: Cloud Functions만 접근 (토큰 캐시 등)
    match /system/{docId} {
      allow read, write: if false;
    }

    // club_admin_requests: 팀 관리자 권한 신청. 인증 요청과 같은 모양이다 —
    // 사진을 올리고 운영자가 카톡에서 보고 승인한다.
    //
    // 인증 사진은 "이 팀이 실제로 운영 중이다"를 보이지만, 관리자 신청 사진은
    // "내가 이 팀 사람이다"를 보여야 한다. 공개된 인스타 사진은 앞의 것만
    // 증명하므로 증빙으로 못 쓴다(안내 문구가 단톡방 캡처 등을 요구한다).
    //
    // 승인·거절은 Functions(admin SDK)만 한다. 신청자가 자기 요청을 승인으로
    // 바꿀 수 있으면 절차 전체가 무의미하다.
    //
    // 만들 때는 신청 필드만 받는다. reviewed_at·reject_reason 은 심사 결과라
    // 서버(admin SDK)만 쓴다 — 신청자가 거절 사유를 미리 박아 넣을 이유가 없다.
    // 사진은 우리 Storage 의 다운로드 URL 만 받는다. 아무 URL 이나 받으면 챗봇
    // 카드가 바깥 이미지를 그대로 띄우고, 운영자가 그 링크를 누르게 된다.
    function adminReqFieldsValid() {
      let d = request.resource.data;
      return d.keys().hasOnly([
               'club_id', 'club_name', 'photo_url',
               'requested_by', 'requested_at', 'status'
             ])
          && d.club_id is string && d.club_id.size() > 0 && d.club_id.size() <= 200
          && (!('club_name' in d) || (d.club_name is string && d.club_name.size() <= 120))
          && d.photo_url is string && d.photo_url.size() > 0 && d.photo_url.size() <= 1000
          && d.photo_url.matches('^https://firebasestorage[.]googleapis[.]com/.*')
          && d.requested_at is timestamp;
    }

    match /club_admin_requests/{requestId} {
      // 신청자 본인은 자기 요청 상태를 봐야 한다(심사 중 / 거절 사유).
      allow read: if isAdmin()
                  || (request.auth != null
                      && resource.data.requested_by == request.auth.uid);

      // 익명 인증(무로그인 픽업 등록용)으로는 신청할 수 없다 — 승인되면 그 uid 가
      // 팀 관리자가 되는데, 익명 계정은 기기를 바꾸면 사라진다.
      allow create: if request.auth != null
                    && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous'
                    && request.resource.data.requested_by == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && adminReqFieldsValid();

      allow update, delete: if false;
    }

    // club_claims: 초기 구글시트 접수 때 받은 팀 담당자 메일. Functions 전용.
    //
    // clubs 는 allow read: if true 라 여기에 메일을 두면 전 세계에 공개된다.
    // 그래서 별도 컬렉션으로 빼고 클라이언트는 읽지도 쓰지도 못하게 막는다 —
    // 매칭은 서버가 하고, 사용자는 '내 팀이 맞다/아니다' 결과만 본다.
    match /club_claims/{clubId} {
      allow read, write: if false;
    }

    // club_claim_requests: 메일이 일치해 접수된 소유권 요청. 승인은 운영자가 한다.
    // 생성·승인 모두 Functions 가 하므로 클라이언트 쓰기는 없다. 관리자는
    // 콘솔에서 이력을 볼 수 있어야 하므로 읽기만 연다.
    match /club_claim_requests/{requestId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── 밥친구 ─────────────────────────────────────────────────────
    // 운동 시간표는 사실상 '언제 어디에 있는지'라서, 친구는 서로 수락해야 맺어지고
    // 찾는 길은 초대코드 하나뿐이다(밥이름 검색 없음). 익명 인증(무로그인 픽업 등록용)은 못 쓴다.
    function isMember() {
      return request.auth != null
             && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous';
    }

    // invite_codes/{CODE}: 초대코드 → 주인 uid.
    //   · 코드를 알아야 신청할 수 있다 — list 는 막아 코드 목록을 긁어 가지 못하게.
    //   · 6자, 헷갈리는 0·O·1·I 는 뺀 32자. 새 코드를 받으면 옛 코드 문서를 지운다(즉시 무효).
    match /invite_codes/{code} {
      allow get: if isMember();
      allow list: if false;
      allow create: if isMember()
                    && code.matches('^[A-HJ-NP-Z2-9]{6}$')
                    && request.resource.data.keys().hasOnly(['uid', 'created_at'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.created_at == request.time;
      allow update: if false;
      allow delete: if isMember() && resource.data.uid == request.auth.uid;
    }

    // friendships/{작은uid_큰uid}: 신청과 친구 관계를 한 문서로.
    //   · 문서 id 가 두 uid 라 쌍마다 하나 — 중복 신청이 생기지 않는다.
    //   · 신청(create)은 상대의 **현재** 초대코드를 들고 와야 한다. uid 만 알아서는 못 건다.
    //   · 수락은 받은 사람만 pending → accepted 로. 다른 필드는 못 바꾼다.
    //   · 거절·취소·끊기는 모두 삭제. 둘 중 누구든 조용히 지울 수 있다(상대에게 알리지 않음).
    function friendPairOk(pairId, d) {
      return d.members is list && d.members.size() == 2
             && d.members[0] < d.members[1]
             && pairId == d.members[0] + '_' + d.members[1];
    }

    match /friendships/{pairId} {
      // get 은 id 에 내 uid 가 들어 있으면 연다 — 없는 문서인지 확인할 수 있어야 신청 전에
      // '이미 신청했나'를 본다. 남의 쌍은 id 를 알아도 못 본다.
      allow get: if isMember() && request.auth.uid in pairId.split('_');
      allow list: if isMember() && request.auth.uid in resource.data.members;

      allow create: if isMember()
                    && friendPairOk(pairId, request.resource.data)
                    && request.resource.data.keys().hasOnly([
                         'members', 'requested_by', 'requested_to', 'status', 'code', 'created_at'
                       ])
                    && request.resource.data.requested_by == request.auth.uid
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.requested_to in request.resource.data.members
                    && request.resource.data.requested_to != request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.created_at == request.time
                    && request.resource.data.code is string
                    && exists(/databases/$(database)/documents/invite_codes/$(request.resource.data.code))
                    && get(/databases/$(database)/documents/invite_codes/$(request.resource.data.code)).data.uid
                         == request.resource.data.requested_to;

      allow update: if isMember()
                    && resource.data.status == 'pending'
                    && request.auth.uid == resource.data.requested_to
                    && request.resource.data.status == 'accepted'
                    && request.resource.data.accepted_at == request.time
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'accepted_at']);

      allow delete: if isMember() && request.auth.uid in resource.data.members;
    }

    // users/{uid}/shared/lunchbox: 밥친구에게 보이는 도시락 사본(2단계).
    //   · 비공개 도시락(private/profile)을 친구에게 여는 대신, 보이기로 켠 팀만 담은 사본을 둔다.
    //     숨긴 팀은 처음부터 여기에 쓰지 않는다 — 받는 쪽 화면에서 가리는 게 아니라 데이터가 안 간다.
    //   · 읽기는 본인과 **수락된** 밥친구만. 신청 중이거나 끊긴 사이는 못 본다.
    //   · 쓰기는 본인만, 모양·크기를 제한한다(도시락은 5칸).
    function isAcceptedFriend(other) {
      let me = request.auth.uid;
      let pid = me < other ? me + '_' + other : other + '_' + me;
      let path = /databases/$(database)/documents/friendships/$(pid);
      return exists(path) && get(path).data.status == 'accepted';
    }

    function sharedLunchboxValid() {
      let d = request.resource.data;
      return d.keys().hasOnly(['teams', 'custom', 'hide_all', 'updated_at'])
          && d.teams is list && d.teams.size() <= 5
          && d.custom is list && d.custom.size() <= 5
          && d.hide_all is bool
          && d.updated_at == request.time;
    }

    match /users/{userId}/shared/{docId} {
      allow read: if isMember()
                  && docId == 'lunchbox'
                  && (request.auth.uid == userId || isAcceptedFriend(userId));
      allow write: if isMember()
                   && request.auth.uid == userId
                   && docId == 'lunchbox'
                   && (request.method == 'delete' || sharedLunchboxValid());
    }

    // 명시되지 않은 컬렉션은 기본적으로 차단 (catch-all 제거)
  }
}
